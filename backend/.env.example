# ─────────────────────────────────────────────────────────────────────────────
# AI CFO & Financial Advisor for MSMEs — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB — use Atlas in most laptop setups (free M0 cluster is enough).
# Replace <user>, <password>, and <cluster> from Atlas → Connect → Drivers.
# URL-encode special characters in the password (e.g. @ → %40).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aicfo?retryWrites=true&w=majority
#
# Local Docker Mongo (docker compose in this folder) instead:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicfo

# JWT — use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI narrative provider — optional. API keys are backend-only and must never
# use a VITE_ prefix. See AI_PROVIDER_SETUP.md in the repository root.
# Set LLM_PROVIDER to openai or gemini. "auto" uses OpenAI when both keys exist.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Comma-separated list of allowed CORS origins (frontend production domain + localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode — only when explicitly enabled does the demo-data generator run
DEMO_MODE=false

# Comma-separated emails that should be granted the ADMIN role
ADMIN_EMAILS=

# Guard-rails
MAX_IMPORT_ROWS=10000
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_HORIZON_DAYS=30
