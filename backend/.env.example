# ─────────────────────────────────────────────────────────────────────────────
# AI CFO & Financial Advisor for MSMEs — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB — use Atlas in most laptop setups (free M0 cluster is enough).
# Replace <user>, <password>, and <cluster> from Atlas → Connect → Drivers.
# URL-encode special characters in the password (e.g. @ → %40).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aicfo?retryWrites=true&w=majority
#
# Local Docker Mongo (docker compose in this folder) instead:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicfo

# JWT — use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Bedrock — optional narrative layer.
# Full step-by-step setup (account, model access, IAM access key, model IDs):
# see AWS_BEDROCK_SETUP.md in the repository root.
# Option A — put an IAM access key here (never commit the real .env):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=            # only for temporary credentials
# Option B — leave the keys empty and use a named profile from
# ~/.aws/credentials (set AWS_PROFILE=myprofile), or run on EC2/ECS with an
# IAM role and configure nothing at all.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_TIMEOUT_SECONDS=90
BEDROCK_MAX_RETRIES=2

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Comma-separated list of allowed CORS origins (frontend production domain + localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode — only when explicitly enabled does the demo-data generator run
DEMO_MODE=false

# Comma-separated emails that should be granted the ADMIN role
ADMIN_EMAILS=

# Guard-rails
MAX_IMPORT_ROWS=10000
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_HORIZON_DAYS=30
