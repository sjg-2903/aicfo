# ─────────────────────────────────────────────────────────────────────────────
# AI CFO & Financial Advisor for MSMEs — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB — use Atlas in most laptop setups (free M0 cluster is enough).
# Replace <user>, <password>, and <cluster> from Atlas → Connect → Drivers.
# URL-encode special characters in the password (e.g. @ → %40).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aicfo?retryWrites=true&w=majority
#
# Local Docker Mongo (docker compose in this folder) instead:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicfo

# JWT — use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider for AI narrative + document extraction (optional).
#   LLM_PROVIDER=openai  → any OpenAI-compatible Chat Completions endpoint.
#     Works with OpenAI, DeepSeek, Groq, OpenRouter, Together AI, Mistral,
#     Azure OpenAI, and self-hosted servers (vLLM / Ollama) by changing
#     OPENAI_BASE_URL and OPENAI_MODEL.
#   LLM_PROVIDER=gemini  → Google Gemini (legacy).
# When no key is configured, the AI CFO uses deterministic explanations
# built from the trusted backend calculations (no fake numbers).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini (legacy, optional).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Comma-separated list of allowed CORS origins (frontend production domain + localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode — only when explicitly enabled does the demo-data generator run
DEMO_MODE=false

# Comma-separated emails that should be granted the ADMIN role
ADMIN_EMAILS=

# Guard-rails
MAX_IMPORT_ROWS=10000
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_HORIZON_DAYS=30
