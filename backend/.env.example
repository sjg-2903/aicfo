# ─────────────────────────────────────────────────────────────────────────────
# AI CFO & Financial Advisor for MSMEs — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB — use Atlas in most laptop setups (free M0 cluster is enough).
# Replace <user>, <password>, and <cluster> from Atlas → Connect → Drivers.
# URL-encode special characters in the password (e.g. @ → %40).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aicfo?retryWrites=true&w=majority
#
# Local Docker Mongo (docker compose in this folder) instead:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicfo

# JWT — use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# xAI Grok — optional narrative layer.
# Create a key at https://console.x.ai/ and set it only in your local secret
# store / deployment secret manager. The backend uses Grok for explanations,
# summaries, insights and AI CFO chat; calculations and recommendation rules
# remain deterministic. Requests use xAI's Responses API with store=false.
# Leave XAI_API_KEY blank to use deterministic explanations only.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_TIMEOUT_SECONDS=90
XAI_MAX_RETRIES=2

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Comma-separated list of allowed CORS origins (frontend production domain + localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode — only when explicitly enabled does the demo-data generator run
DEMO_MODE=false

# Comma-separated emails that should be granted the ADMIN role
ADMIN_EMAILS=

# Guard-rails
MAX_IMPORT_ROWS=10000
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_HORIZON_DAYS=30
