# ─────────────────────────────────────────────────────────────────────────
# AI CFO — example Terraform variables.
# Copy to terraform.tfvars and adjust. Do NOT commit real values
# (terraform.tfvars is git-ignored).
# ─────────────────────────────────────────────────────────────────────────

# aws_region        = "ap-south-1"
# project           = "aicfo"
# environment       = "prod"

# instance_type     = "t3.small"
# data_volume_size_gb = 30

# ── Access (recommended: no SSH, use SSM Session Manager) ─────────────────
# key_name         = "my-existing-key"
# allowed_ssh_cidrs = ["203.0.113.0/24"]

# ── Custom domain (optional) ───────────────────────────────────────────────
# domain_name       = "app.example.com"
# route53_zone_name = "example.com"
# enable_www        = false

# ── Off-site backups (optional; bucket name must be globally unique) ───────
# backup_bucket_name = "aicfo-prod-db-backups"

# ── AI credentials (optional; pass via TF_VAR_* instead of this file!) ─────
# openai_api_key    = ""
# gemini_api_key    = ""
# admin_emails      = ""

# ── Application ────────────────────────────────────────────────────────────
# git_repo_url      = "https://github.com/sjg-2903/aicfo.git"
# git_branch        = "main"
# ssm_path_prefix   = "/aicfo/prod"
